# Local development default: http://localhost:1337
# Production default: https://xokeza.su/amour/api (or custom instance)
VITE_API_URL=http://localhost:1337
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun

AMOUR_DEV_SIGNING_SECRET=

# Optional Amour update infrastructure (disabled when unset). Never point to upstream releases.
AMOUR_APP_UPDATE_URL=
AMOUR_UPDATER_URL=
AMOUR_UPDATER_PUBLIC_KEY=
# Software rendering fallback for problematic graphics drivers.
AMOUR_DISABLE_GPU=
